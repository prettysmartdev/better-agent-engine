#!/usr/bin/env bash
set -euo pipefail
# Generated by `baectl setup` (variant: max, flags: --dev --apple, unix: 1790196050).
# Re-run `baectl setup` in this directory to launch or edit it.
cd "$(dirname "$0")"

# Read only BAE_ADDR_PORT from .env, without evaluating the file.
BAE_ADDR_PORT="$(sed -n 's/^BAE_ADDR_PORT=//p' .env 2>/dev/null | tail -n1)"
BAE_ADDR_PORT="${BAE_ADDR_PORT:-8080}"

container volume inspect bae-data >/dev/null 2>&1 || container volume create bae-data
container stop bae-max >/dev/null 2>&1 || true
container rm bae-max >/dev/null 2>&1 || true

# Give the image's non-root `bae` user ownership of the data volume: a
# volume `container` created is root-owned, which would fail baesrv's
# SQLite open. Only this throwaway container runs as root.
container run --rm --user 0:0 --entrypoint /bin/chown \
  --volume bae-data:/var/lib/bae \
  better-agent-engine:max -R bae:bae /var/lib/bae

container run -d --name bae-max \
  --publish "${BAE_ADDR_PORT}:8080" \
  --publish "3000:3000" \
  --volume bae-data:/var/lib/bae \
  --volume "$(pwd)/bae-config.toml:/etc/bae/config.toml:ro" \
  --env-file .env \
  --env BAE_CONFIG=/etc/bae/config.toml \
  better-agent-engine:max
